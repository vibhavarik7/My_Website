# Environment Variables Configuration
# Copy this file to .env and fill in your values
# The .env file is gitignored and won't be committed to GitHub

# Secret key for Flask sessions (generate a random string)
SECRET_KEY=your-secret-key-here-change-this

# Admin password for accessing the admin panel
ADMIN_PASSWORD=your-secure-admin-password-here

# Flask environment (development or production)
FLASK_ENV=development

# Port (only needed for local development, Render sets this automatically)
PORT=5001

